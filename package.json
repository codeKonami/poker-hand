{
  "name": "poker-hand-evaluator",
  "version": "1.0.1",
  "description": "Poker Texas Holdem Hand Evaluator using Cactus Kev's algorithm",
  "keywords": [
    "poker",
    "evaluator",
    "Cactus Kev",
    "algorithm",
    "texas holdem"
  ],
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dist/pokerhand.min.js": "./dist/pokerhand.min.js",
    "./package.json": "./package.json",
    "./package": "./package.json",
    "./index": {
      "import": "./dist/index.mjs",
      "default": "./index.js"
    },
    "./index.js": {
      "import": "./dist/index.mjs",
      "default": "./index.js"
    },
    "./src/pokerhand": {
      "import": "./dist/index.mjs",
      "default": "./src/pokerhand.js"
    },
    "./src/pokerhand.js": {
      "import": "./dist/index.mjs",
      "default": "./src/pokerhand.js"
    },
    "./src/utils/sanitize": "./src/utils/sanitize.js",
    "./src/utils/sanitize.js": "./src/utils/sanitize.js",
    "./src/utils/eval-hand": "./src/utils/eval-hand.js",
    "./src/utils/eval-hand.js": "./src/utils/eval-hand.js",
    "./src/utils/eval-rank": "./src/utils/eval-rank.js",
    "./src/utils/eval-rank.js": "./src/utils/eval-rank.js",
    "./src/utils/is-valid-card": "./src/utils/is-valid-card.js",
    "./src/utils/is-valid-card.js": "./src/utils/is-valid-card.js",
    "./src/arrays": "./src/arrays/index.js",
    "./src/arrays/": "./src/arrays/index.js",
    "./src/arrays/index": "./src/arrays/index.js",
    "./src/arrays/index.js": "./src/arrays/index.js",
    "./src/arrays/flushes": "./src/arrays/flushes.js",
    "./src/arrays/flushes.js": "./src/arrays/flushes.js",
    "./src/arrays/hand-ranks": "./src/arrays/hand-ranks.js",
    "./src/arrays/hand-ranks.js": "./src/arrays/hand-ranks.js",
    "./src/arrays/products": "./src/arrays/products.js",
    "./src/arrays/products.js": "./src/arrays/products.js",
    "./src/arrays/ranks": "./src/arrays/ranks.js",
    "./src/arrays/ranks.js": "./src/arrays/ranks.js",
    "./src/arrays/suits": "./src/arrays/suits.js",
    "./src/arrays/suits.js": "./src/arrays/suits.js",
    "./src/arrays/unique5": "./src/arrays/unique5.js",
    "./src/arrays/unique5.js": "./src/arrays/unique5.js",
    "./src/arrays/values": "./src/arrays/values.js",
    "./src/arrays/values.js": "./src/arrays/values.js",
    "./example": "./example/index.js",
    "./example/": "./example/index.js",
    "./example/index": "./example/index.js",
    "./example/index.js": "./example/index.js",
    "./dist/pokerhand.min": "./dist/pokerhand.min.js",
    "./*/": "./*/index.js"
  },
  "engines": {
    "node": ">=6"
  },
  "files": [
    "dist",
    "index.js",
    "src/pokerhand.js",
    "src/utils",
    "src/arrays",
    "example"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
    "es-check": "es-check --config=.escheckrc",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx src/bench.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "compat": "vitest run --config compat/vitest.config.mts",
    "compat:lint": "npm run build && npm run compat:publint && npm run compat:attw",
    "compat:publint": "publint --strict",
    "compat:attw": "attw --pack . --entrypoints . ./package.json",
    "compat:smoke": "node compat/smoke/run.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codeKonami/poker-hand.git"
  },
  "author": {
    "name": "codeKonami",
    "email": "thomas.foricher@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.6.9",
    "@changesets/cli": "^3.0.3",
    "@swc/core": "^1.16.22",
    "@types/jsdom": "^30.0.0",
    "es-check": "^9.9.0",
    "jsdom": "^31.0.1",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
