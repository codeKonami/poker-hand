{
  "name": "poker-hand-evaluator",
  "version": "1.0.1",
  "description": "Poker Texas Holdem Hand Evaluator using Cactus Kev's algorithm",
  "keywords": [
    "poker",
    "evaluator",
    "Cactus Kev",
    "algorithm",
    "texas holdem"
  ],
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=6"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
    "es-check": "es-check --config=.escheckrc",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx src/bench.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "compat": "vitest run --config compat/vitest.config.mts",
    "compat:lint": "npm run build && npm run compat:publint && npm run compat:attw",
    "compat:publint": "publint --strict",
    "compat:attw": "attw --pack .",
    "compat:smoke": "node compat/smoke/run.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codeKonami/poker-hand.git"
  },
  "author": {
    "name": "codeKonami",
    "email": "thomas.foricher@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.6.9",
    "@types/jsdom": "^30.0.0",
    "es-check": "^9.9.0",
    "jsdom": "^31.0.1",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
